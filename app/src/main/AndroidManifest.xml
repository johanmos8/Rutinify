<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Exact alarms on API 31+ (R-5.3); USE_EXACT_ALARM is deliberately not declared (D-09) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Alarm notifications on API 33+ (R-7.1); without it alarms still move to FIRED (R-7.8) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Reschedule pending alarms after boot (R-12.1) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Alarm screen of critical alarms over the lock screen (R-15.7, D-68); its fallback and Permissions row are T-47 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- The QR scanner library asks for network access for its own telemetry; scanning runs in Google Play services,
         so the app keeps no network permission (R-13.6, D-75) -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <!-- "Abrir en IA" checks for apps that receive text (R-14.8, D-65) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />

            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:name=".RutinifyApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rutinify">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Rutinify">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Text shared from an AI app (R-14.1); singleTask brings back the app's own task (D-64) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Plan shared as a link or QR code (R-19.7, D-75) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="import"
                    android:scheme="rutinify" />
            </intent-filter>
        </activity>

        <!-- Critical alarm screen (R-15.7): only from the app's full-screen intent; own task, out of recents -->
        <activity
            android:name=".ui.alarm.AlarmActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Rutinify"
            android:turnScreenOn="true" />

        <!-- History PDFs shared with other apps (R-20.5, D-78) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Only reached through the app's own explicit PendingIntent (design §7) -->
        <receiver
            android:name=".data.receiver.AlarmReceiver"
            android:exported="false" />
        <receiver
            android:name=".data.receiver.NotificationActionReceiver"
            android:exported="false" />

        <!-- Exported only to receive protected system broadcasts (design §7.1) -->
        <receiver
            android:name=".data.receiver.RescheduleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>