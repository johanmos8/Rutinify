    <string name="permissions_title">Permisos</string>
    <string name="permissions_intro">Rutinify necesita estos permisos para que cada alarma suene a su hora y se vea con sus botones.</string>
    <string name="permissions_all_granted">Todo listo: las alarmas sonarán a su hora.</string>
    <string name="permissions_notifications_title">Notificaciones</string>
    <string name="permissions_notifications_description">Para mostrar cada aviso con sus botones «Hecho» y «+5 min». Sin él, las alarmas se marcan como disparadas pero no ves nada.</string>
    <string name="permissions_exact_title">Alarmas exactas</string>
    <string name="permissions_exact_description">Para que cada aviso llegue a su hora exacta. Sin él, Android puede retrasarlo unos minutos.</string>
    <string name="permissions_granted">Concedido</string>
    <string name="permissions_missing">Falta</string>
    <string name="permissions_battery_note">Algunos fabricantes cierran las apps en segundo plano para ahorrar batería. Si una alarma no suena, busca tu modelo en dontkillmyapp.com y sigue sus pasos.</string>
    <string name="action_fix">Corregir</string>
    <string name="home_permissions_banner">Faltan permisos: puede que las alarmas no suenen a tiempo o no se vean.</string>
    <string name="action_review_permissions">Revisar</string>
    <string name="review_notifications_title">Avisos en pantalla</string>
    <string name="review_notifications_body">Para que veas cada alarma con sus botones «Hecho» y «+5 min», Rutinify necesita permiso para mostrar notificaciones. Android te lo preguntará ahora.</string>
    <string name="review_exact_title">Alarmas exactas desactivadas</string>
    <string name="review_exact_body">Sin el permiso de alarmas exactas, Android puede retrasar cada aviso unos minutos. Puedes activarlo en ajustes o programar igualmente.</string>
