    <string name="permissions_intro">Rutinify needs these permissions so every alarm rings on time and shows its buttons.</string>
    <string name="permissions_all_granted">All set: alarms will ring on time.</string>
    <string name="permissions_notifications_title">Notifications</string>
    <string name="permissions_notifications_description">To show each reminder with its “Done” and “+5 min” buttons. Without it, alarms are marked as fired but you see nothing.</string>
    <string name="permissions_exact_title">Exact alarms</string>
    <string name="permissions_exact_description">So each reminder arrives at its exact time. Without it, Android may delay it a few minutes.</string>
    <string name="permissions_granted">Granted</string>
    <string name="permissions_full_screen_title">Full-screen alarms</string>
    <string name="permissions_full_screen_description">So critical alarms turn the screen on and show over the lock screen. Without it they still ring, but as a pop-up notification.</string>
    <string name="permissions_enabled">On</string>
    <string name="permissions_disabled">Off</string>
    <string name="permissions_missing">Missing</string>
    <string name="permissions_battery_note">Some manufacturers close background apps to save battery. If an alarm does not ring, look up your model on dontkillmyapp.com and follow its steps.</string>
    <string name="action_fix">Fix</string>
    <string name="home_exact_card_title">Turn on exact alarms</string>
    <string name="home_exact_card_body">Android has exact alarms turned off for Rutinify, so each reminder may arrive a few minutes late. Turn them on so they ring on time.</string>
